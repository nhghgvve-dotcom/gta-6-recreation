config_version=5

[application]
config/name="Coastline"
config/icon="res://assets/coastline_app_icon.svg"
boot_splash/show_image=false
boot_splash/image="res://assets/living_room_studios_boot_splash.svg"
boot_splash/fullsize=true
boot_splash/minimum_display_time=20.0
boot_splash/bg_color=Color(0.03, 0.06, 0.14, 1)
run/main_scene="res://Splash.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="A third-person tropical open-world driving and exploration prototype."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[xr]
openxr/enabled=true
openxr/extensions/hand_tracking=true
openxr/extensions/hand_tracking_unobstructed_data_source=true
openxr/extensions/hand_tracking_controller_data_source=true
openxr/extensions/hand_interaction_profile=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.47, 0.68, 0.82, 1)
